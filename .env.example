# ── Traducción (seña → español → idioma elegido) ─────────────────────────────
# Por defecto usa MyMemory GRATIS (no hace falta clave).
# Opcional: email para subir el cupo diario (~1000 → ~10000 chars/día):
MYMEMORY_EMAIL=

# Opcional: clave de cuenta MyMemory (TM privada / más cuota).
# Cómo sacarla: ver instrucciones en el chat / https://mymemory.translated.net/
MYMEMORY_API_KEY=

# Opcional: si tienes Google Cloud Translation, tiene prioridad sobre MyMemory.
# GOOGLE_TRANSLATE_API_KEY=

{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Signara",
  "version": "0.1.0",
  "identifier": "co.signara.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Signara",
        "url": "/#mode",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 650,
        "additionalBrowserArgs": "--disable-features=msSpeechRecognitionServiceUseCetoService",
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "overlay",
        "title": "Signara",
        "url": "/?overlay=1",
        "width": 420,
        "height": 650,
        "minWidth": 240,
        "minHeight": 300,
        "additionalBrowserArgs": "--disable-features=msSpeechRecognitionServiceUseCetoService",
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "center": false,
        "visible": false
      },
      {
        "label": "interpret-overlay",
        "title": "Signara",
        "url": "/?overlay=interpret",
        "width": 360,
        "height": 460,
        "minWidth": 240,
        "minHeight": 260,
        "additionalBrowserArgs": "--disable-features=msSpeechRecognitionServiceUseCetoService",
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "center": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../desktop_audio/worker.py": "desktop_audio/worker.py",
      "../desktop_audio/streaming.py": "desktop_audio/streaming.py",
      "../desktop_audio/model_store.py": "desktop_audio/model_store.py",
      "../desktop_audio/low_latency.py": "desktop_audio/low_latency.py",
      "../desktop_audio/resident.py": "desktop_audio/resident.py",
      "../desktop_audio/recognition.py": "desktop_audio/recognition.py",
      "../desktop_audio/requirements.txt": "desktop_audio/requirements.txt"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
